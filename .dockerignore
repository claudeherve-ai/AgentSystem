# Docker build context excludes — speeds up `COPY . .` and prevents
# accidental inclusion of local venvs, caches, and backups.
.venv
.venv-wsl
__pycache__
*.pyc
.git
.gitignore
.dockerignore
.env
.mypy_cache
.pytest_cache
.ruff_cache
node_modules
**/bin
**/obj
frontend/dist
frontend/coverage
frontend/node_modules
_backup_*
memory/*.db
memory/*.log
memory/*.json
memory/projects/
logs/
*.tar.gz
.azure/
.github/
.hermes/
docs/
tests/
infra/
