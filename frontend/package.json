{
  "name": "agentsystem-mission-control",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AgentSystem mission-control frontend — task composition, live run topology, approvals, and operations views over the AgentSystem API.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
