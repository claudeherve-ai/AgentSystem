# =============================================================================
# nginx.conf.template — AgentSystem frontend
# Rendered at container start by the nginx-unprivileged image's built-in
# envsubst-on-templates entrypoint (only ${API_INTERNAL_BASE_URL} is
# substituted; see NGINX_ENVSUBST_FILTER in frontend/Dockerfile) into
# /etc/nginx/conf.d/default.conf.
# =============================================================================

# Azure-internal DNS resolver. Required so nginx re-resolves the internal API
# Container App's FQDN at request time (via the $api_upstream variable
# below) instead of failing permanently if that hostname isn't resolvable
# yet at nginx startup (e.g. rolling deploys, revision changes).
resolver 168.63.129.16 valid=30s;

server {
    listen       8080;
    listen       [::]:8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ---- Trust boundary: Microsoft Entra identity ---------------------------
    # Azure Container Apps built-in authentication (Easy Auth) sits in front
    # of this container and validates every request except the paths listed
    # in infra/modules/containerApps.bicep `authExcludedPaths` (today only
    # '/healthz/*', which ACA's own container-level liveness/readiness probes
    # use because they carry no Entra token). On any authenticated path, Easy
    # Auth validates the browser session and, with its token store enabled,
    # injects the signed Entra ID token as X-MS-TOKEN-AAD-ID-TOKEN. The proxy
    # forwards that token as a bearer credential; the internal API verifies its
    # signature, issuer, audience, and lifetime independently.
    #
    # Defense in depth: clear the headers here as the server-wide default so
    # any location that does NOT explicitly re-declare them — including the
    # excluded, unauthenticated /healthz/* probes below (which never proxy
    # anywhere) and /readiness + /live (which don't need caller identity) —
    # can never pass a client-supplied value through to the internal API,
    # even if the excluded-path list grows or Easy Auth is ever misconfigured.
    proxy_set_header X-MS-CLIENT-PRINCIPAL "";
    proxy_set_header X-MS-CLIENT-PRINCIPAL-ID "";
    proxy_set_header X-MS-CLIENT-PRINCIPAL-NAME "";
    proxy_set_header Authorization "";

    # ---- Local-only probes (never proxied) -------------------------------
    # Used exclusively by Azure Container Apps' liveness/readiness/startup
    # probes (infra/modules/containerApps.bicep frontendApp). Intentionally
    # decoupled from the API's own health so a transient backend outage
    # cannot cascade into ACA restarting this container.
    location = /healthz/live {
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /healthz/ready {
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---- Reverse proxy to the internal API Container App ------------------
    # ${API_INTERNAL_BASE_URL} is injected by ACA (e.g.
    # "https://ca-api-<token>.internal.<env-domain>") and substituted here at
    # container start. Using a variable (not a bare proxy_pass target) forces
    # nginx to resolve it via the `resolver` directive above at request time
    # rather than only once at config load.
    set $api_upstream "${API_INTERNAL_BASE_URL}";

    location /api/ {
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "Bearer $http_x_ms_token_aad_id_token";
        proxy_read_timeout 60s;
    }

    # The SPA's own in-app backend-status widget calls these directly
    # (frontend/src/hooks/useHealth.ts); reverse-proxied straight through to
    # the API's own truthful health/readiness, distinct from /healthz/* above.
    location /health/ {
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "Bearer $http_x_ms_token_aad_id_token";
    }

    location = /readiness {
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;
    }

    location = /live {
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;
    }

    # ---- SPA fallback -------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Long-cache immutable, content-hashed Vite build assets.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
}
