# AgentSystem frontend runtime configuration.
# Copy to .env or .env.local for local development (Vite auto-loads .env*.local).
# Only variables prefixed with VITE_ are exposed to client code.

# Base URL of the AgentSystem API (no trailing slash). Point this at your
# local `uvicorn api.main:app` instance or a deployed environment.
VITE_API_BASE_URL=http://localhost:8080

# Auth mode the frontend should use when calling the API:
#   none          — no credentials attached (server has auth disabled)
#   api_key       — attach an operator-supplied key as an Authorization header
#   easy_auth     — same-origin App Service Easy Auth; requests use
#                   credentials: "include" and no bearer header is attached
#   entra_bearer  — attach a bearer token supplied by an external token
#                   provider (wire one via configureEntraTokenProvider(); see
#                   src/api/auth/entraAuthProvider.ts). Never fabricated here.
VITE_AUTH_MODE=api_key

# Optional: poll interval (ms) for the operations/dependency health view.
VITE_HEALTH_POLL_MS=15000
